package pt.up.fe.comp.extensions.ollir.statements.jmm;

class DoWhileNested {

    public int method(int limit) {
        int i;
        int j;
        i = 0;

        do {
            j = 0;
            do {
                j = j + 1;
            } while (j < limit);
            i = i + 1;
        } while (i < limit);

        return i;
    }
}