package pt.up.fe.comp.extensions.ollir.statements.jmm;

class ForLoopNested {

    public int method(int limit) {
        int i;
        int j;
        int sum;
        sum = 0;

        for (i = 0; i < limit; i = i + 1) {
            for (j = 0; j < limit; j = j + 1) {
                sum = sum + 1;
            }
        }

        return sum;
    }
}