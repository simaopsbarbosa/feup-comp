package pt.up.fe.comp.cp1.core.semantics.calls.semanticanalysis;


class UnaryArithmeticOperatorsOk {
    public static void main(String[] args) {
    }

    public int testSuccess() {
        int a;
        int b;
        boolean res;

        a = 10;
        b = 3;

        // Unary
        a = +a;
        a = -a;
        a++;
        a--;

        // Extended Binary
        a = a % b;

        // Relational
        res = (a == b);
        res = (a != b);
        res = (a > b);
        res = (a >= b);
        res = (a <= b);

        // Logical
        res = (res || false);

        return a;
    }
}