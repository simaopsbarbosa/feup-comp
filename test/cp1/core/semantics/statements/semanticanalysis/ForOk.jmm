package core.semantics.statements;

class ForOk {
    public int testSuccess() {
        int i;
        int sum;
        sum = 0;
        for (i = 0; i < 10; i = i + 1) {
            sum = sum + i;
        }
        return sum;
    }

    public int testMultipleInit() {
        int i;
        int j;
        for (i = 0, j = 10; i < j; i = i + 1, j = j - 1) {
            i = i + 1;
        }
        return i;
    }
}
